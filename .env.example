# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# MERCADOPAGO_ACCESS_TOKEN: Token de Producción o Prueba de Mercado Pago (formato APP_USR-...)
# El servidor lo consulta de forma segura desde el backend (server.ts) sin exponerlo jamás al cliente ni en el código visible.
MERCADOPAGO_ACCESS_TOKEN=""

# DATABASE_URL: Cadena de conexión para PostgreSQL Central (Neon, Supabase, Cloud SQL o PostgreSQL compatible)
# Formato: postgresql://[usuario]:[password]@[host]:[puerto]/[base_de_datos]?sslmode=require
# Sin base central no se permiten sesiones nuevas, salvo demo explícita y aislada.
DATABASE_URL=""

# Autenticación normal: base PostgreSQL obligatoria. Demo nunca se activa implícitamente.
SGMO_AUTH_MODE="central"

# Origen exacto de la app: https://tu-dominio.vercel.app (sin barra final).
# En preview Vercel puede usar VERCEL_URL automáticamente; no usar el dominio productivo en una preview.
SGMO_PUBLIC_ORIGIN=""
# Transporte Bearer exclusivo para clientes API explícitos. Dejar false para navegadores.
SGMO_ENABLE_API_TOKENS="false"
# Secret de firma Webhooks provisto por Mercado Pago; diferente del token de acceso.
MERCADOPAGO_WEBHOOK_SECRET=""
# ID de cuenta receptora de Mercado Pago (no correo ni alias).
MERCADOPAGO_COLLECTOR_ID=""
# Certificados remotos se verifican siempre. CA privada sólo si la necesita el proveedor.
DATABASE_SSL="true"
DATABASE_SSL_CA=""

# Aprovisionamiento inicial: secreto aleatorio de al menos 32 caracteres, exclusivamente del servidor.
# Ausente = endpoint deshabilitado. Retirarlo después del alta; no reutilizarlo para restablecimientos.
BOOTSTRAP_SECRET=""

# Solo demo local: NODE_ENV=development/test + SGMO_AUTH_MODE=demo, sin variables DATABASE_URL/PG.
# Proporcionar credenciales efímeras robustas; no hay credenciales predeterminadas.
SGMO_DEMO_ADMIN_PASSWORD=""
SGMO_DEMO_SELLER_PIN=""
SGMO_DEMO_FACTORY_PIN=""
